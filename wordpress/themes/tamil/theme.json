{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "papier",
					"name": "Papier",
					"color": "#F1F5F9"
				},
				{
					"slug": "papier-2",
					"name": "Papier 2 (Mulde, Fuß)",
					"color": "#E5EAEF"
				},
				{
					"slug": "papier-3",
					"name": "Papier 3 (Bildgrund)",
					"color": "#D8DFE5"
				},
				{
					"slug": "blatt",
					"name": "Blatt (Tabellen)",
					"color": "#FBFDFF"
				},
				{
					"slug": "tinte",
					"name": "Tinte",
					"color": "#0C151C"
				},
				{
					"slug": "tinte-2",
					"name": "Tinte 2 (Vorspann)",
					"color": "#222A31"
				},
				{
					"slug": "grau",
					"name": "Grau (Stand, Nachweise)",
					"color": "#4B545B"
				},
				{
					"slug": "linie",
					"name": "Linie",
					"color": "#C5CBD0"
				},
				{
					"slug": "linie-fest",
					"name": "Linie fest (Blattkante)",
					"color": "#2B343B"
				},
				{
					"slug": "rot",
					"name": "Rot (nur „als Nächstes“)",
					"color": "#B5282A"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1320px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "1",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "2",
					"name": "S",
					"size": "12px"
				},
				{
					"slug": "3",
					"name": "M",
					"size": "16px"
				},
				{
					"slug": "4",
					"name": "L",
					"size": "24px"
				},
				{
					"slug": "5",
					"name": "XL",
					"size": "40px"
				},
				{
					"slug": "6",
					"name": "XXL",
					"size": "64px"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "titel",
					"name": "Rethink Sans",
					"fontFamily": "\"Rethink Sans\", Catamaran, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rethink Sans",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rethink-sans-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Rethink Sans",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rethink-sans-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "text",
					"name": "Golos Text",
					"fontFamily": "\"Golos Text\", Catamaran, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Golos Text",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/golos-text-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Golos Text",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/golos-text-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "tamil",
					"name": "Catamaran (nur Tamil im Inhalt)",
					"fontFamily": "Catamaran, \"Golos Text\", ui-sans-serif, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Catamaran",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/catamaran-tamil.woff2"
							],
							"unicodeRange": "U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "klein",
					"name": "Klein (Stand, Nachweise)",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "mittel",
					"name": "Mittel",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "text",
					"name": "Text",
					"size": "1.125rem",
					"fluid": false
				},
				{
					"slug": "vorspann",
					"name": "Vorspann",
					"size": "clamp(1.125rem, 0.35vw + 1rem, 1.375rem)",
					"fluid": false
				},
				{
					"slug": "zeile",
					"name": "Titel in Listen",
					"size": "clamp(1.25rem, 0.75vw + 0.875rem, 1.625rem)",
					"fluid": false
				},
				{
					"slug": "h2",
					"name": "Abschnitt",
					"size": "clamp(1.375rem, 0.5vw + 1.2rem, 1.75rem)",
					"fluid": false
				},
				{
					"slug": "h1",
					"name": "Schlagzeile",
					"size": "clamp(1.875rem, 1.6vw + 1.2rem, 2.75rem)",
					"fluid": false
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|papier",
			"text": "var:preset|color|tinte"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|text",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|tinte"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|titel",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|h1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|h2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|zeile"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|tinte",
					"text": "var:preset|color|papier"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|text",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|linie-fest",
						"width": "2px"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|linie-fest",
						"width": "2px"
					},
					"bottom": {
						"color": "var:preset|color|linie",
						"width": "1px"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|titel",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|linie"
				}
			}
		}
	},
	"customTemplates": [],
	"templateParts": []
}
