{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "grund",
					"name": "Grund (oklch 0.985 0.002 250)",
					"color": "#F9FAFB"
				},
				{
					"slug": "flaeche",
					"name": "Fläche (oklch 0.962 0.003 250)",
					"color": "#F1F3F4"
				},
				{
					"slug": "tinte",
					"name": "Tinte (oklch 0.21 0.012 255)",
					"color": "#15191E"
				},
				{
					"slug": "leise",
					"name": "Leise (oklch 0.45 0.012 255)",
					"color": "#51565C"
				},
				{
					"slug": "linie",
					"name": "Linie (oklch 0.88 0.004 250)",
					"color": "#D5D8DA"
				},
				{
					"slug": "rot",
					"name": "Rot, nur Akzent (oklch 0.508 0.177 25.6)",
					"color": "#B5282A"
				},
				{
					"slug": "hell-leise",
					"name": "Leise hell, auf Dunkel (oklch 0.82 0.006 250)",
					"color": "#C1C4C8"
				},
				{
					"slug": "linie-dunkel",
					"name": "Linie auf Dunkel (oklch 0.36 0.010 255)",
					"color": "#3A3D42"
				},
				{
					"slug": "flaeche-dunkel",
					"name": "Fläche auf Dunkel (oklch 0.26 0.012 255)",
					"color": "#20242A"
				}
			]
		},
		"layout": {
			"contentSize": "560px",
			"wideSize": "1040px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "1",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "2",
					"name": "S",
					"size": "12px"
				},
				{
					"slug": "3",
					"name": "M",
					"size": "16px"
				},
				{
					"slug": "4",
					"name": "L",
					"size": "24px"
				},
				{
					"slug": "5",
					"name": "XL",
					"size": "40px"
				},
				{
					"slug": "6",
					"name": "XXL",
					"size": "64px"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "libre-franklin",
					"name": "Libre Franklin",
					"fontFamily": "\"Libre Franklin\", Catamaran, \"Noto Sans Tamil\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Libre Franklin",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/libre-franklin-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Libre Franklin",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/libre-franklin-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "tamil",
					"name": "Catamaran (nur Tamil, lang=\"ta\")",
					"fontFamily": "Catamaran, \"Noto Sans Tamil\", \"Tamil Sangam MN\", \"Libre Franklin\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Catamaran",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/catamaran-tamil.woff2"
							],
							"unicodeRange": "U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "klein",
					"name": "Klein (Dachzeile, Nachweis), 13 px",
					"size": "0.8125rem"
				},
				{
					"slug": "leise",
					"name": "Leise (Orte, Stand), 15 px",
					"size": "0.9375rem"
				},
				{
					"slug": "text",
					"name": "Text, 17 px",
					"size": "1.0625rem"
				},
				{
					"slug": "lesetext",
					"name": "Lesetext im Artikel, 18 px",
					"size": "1.125rem"
				},
				{
					"slug": "titel",
					"name": "Titel in Listen, 19 px",
					"size": "1.1875rem"
				},
				{
					"slug": "titel-gross",
					"name": "Titel große Kachel, 22 px",
					"size": "1.375rem"
				},
				{
					"slug": "schlagzeile",
					"name": "Schlagzeile, 28 bis 38 px",
					"size": "clamp(1.75rem, 1.2vw + 1.45rem, 2.375rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|grund",
			"text": "var:preset|color|tinte"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|libre-franklin",
			"fontSize": "var:preset|font-size|text",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|tinte"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|libre-franklin",
					"fontWeight": "650",
					"lineHeight": "1.2",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|schlagzeile",
					"lineHeight": "1.12",
					"letterSpacing": "-0.012em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|titel-gross"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|titel"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|tinte",
					"text": "var:preset|color|grund"
				},
				"border": {
					"radius": "0px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|libre-franklin",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|tinte",
						"width": "2px"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|tinte",
						"width": "1px"
					},
					"bottom": {
						"color": "var:preset|color|linie",
						"width": "1px"
					}
				},
				"typography": {
					"fontWeight": "650"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|linie"
				}
			},
			"core/image": {
				"border": {
					"radius": "0px"
				}
			}
		}
	},
	"customTemplates": [],
	"templateParts": []
}
