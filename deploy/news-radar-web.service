[Unit]
Description=Tamil.de Radar – Freigabe-App (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=newsradar
WorkingDirectory=/opt/tamil-news-radar
EnvironmentFile=/opt/tamil-news-radar/.env
# nur lokal lauschen – nach außen über Cloudflare Tunnel (deploy/cloudflared-ingress.yml)
ExecStart=/opt/tamil-news-radar/.venv/bin/gunicorn -w 2 --threads 4 -b 127.0.0.1:8787 --timeout 120 --access-logfile - "news_radar.web:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
