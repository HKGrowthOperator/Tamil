[Unit]
Description=Tamil.de News-Radar (ein Lauf)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=newsradar
WorkingDirectory=/opt/tamil-news-radar
EnvironmentFile=/opt/tamil-news-radar/.env
ExecStart=/opt/tamil-news-radar/.venv/bin/python -m news_radar run
TimeoutStartSec=300
Nice=5
