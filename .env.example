# --- Claude (Texte im Tamil.de-Stil) ---
ANTHROPIC_API_KEY=

# --- Nachrichten-APIs (mindestens eine oder nur RSS) ---
NEWSAPI_KEY=          # https://newsapi.org
GNEWS_TOKEN=          # https://gnews.io

# --- Bilder (optional; ohne Key wird eine Tamil.de-Bildkarte erzeugt) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- WordPress (ohne Angaben: Dry-Run nach ./out) ---
WP_URL=https://www.tamil.de
WP_USER=
WP_APP_PASSWORD=      # WordPress > Benutzer > Profil > Anwendungspasswörter
WP_POST_STATUS=pending   # pending = wartet auf Freigabe (Human-in-the-Loop, §3 Abs. 2)

# --- Benachrichtigung bei neuen Entwürfen (Slack/Teams/Discord-Webhook) ---
NOTIFY_WEBHOOK_URL=

# --- Steuerung ---
RADAR_MAX_ARTICLES=5        # max. neue Entwürfe pro Lauf
RADAR_MAX_AGE_HOURS=36      # nur Meldungen jünger als X Stunden
RADAR_MIN_SCORE=4           # Mindest-Relevanz Stichwort-Filter
RADAR_MIN_RELEVANCE=6       # Mindest-Relevanz laut KI (1-10)
RADAR_DEADLINE_SECONDS=270  # Lauf endet spätestens nach 4,5 Minuten
