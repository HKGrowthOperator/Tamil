# ===== Claude (Texte im Tamil.de-Stil) =====
ANTHROPIC_API_KEY=
# RADAR_ANTHROPIC_API_KEY=        # statt ANTHROPIC_API_KEY, wenn der Radar in einer Claude-Code-Umgebung läuft
# RADAR_DATA_DIR=                 # Datenordner (Standard: data/ im App-Ordner), z. B. für einen Pilot getrennt vom Betrieb
RADAR_MODEL=claude-opus-5-5      # v1: ein Aufruf je Beitrag; in v2 Alias für die Text-Rolle

# ===== Redaktion v2 (Rollen, Belege, Kostenmessung) =====
RADAR_WORKFLOW=v1                # v2 = Multi-Agenten-Redaktion (Worker-Dienst nötig, siehe deploy/install.sh)
RADAR_BUDGET_TAG_USD=5           # harter Stopp für neue bezahlte Schritte (Freigeben/Veröffentlichen laufen weiter)
RADAR_BUDGET_MONAT_USD=150
RADAR_BUDGET_WARNUNG=0.8         # Warnung (Digest + Webhook) ab 80 %
RADAR_ENTWUERFE_TAG=5            # Pilot: höchstens so viele neue bezahlte Storys je Tag
RADAR_PARALLEL_JOBS=2
RADAR_KI_BILDER_JE_ARTIKEL=1
RADAR_RECHERCHE_GOOGLE_NEWS=1    # zweite Quelle über Google-News-RSS suchen (robots.txt-Hinweis im Quellen-Register)
BILD_REIHENFOLGE=archiv,quelle,stock,pool,ki,karte
# Modell je Rolle (Standard: Haiku für signal/cluster/lektorat/seo, Sonnet für recherche/faktencheck/text, Opus für dossier)
RADAR_MODELL_SIGNAL=
RADAR_MODELL_CLUSTER=
RADAR_MODELL_RECHERCHE=
RADAR_MODELL_FAKTENCHECK=
RADAR_MODELL_TEXT=
RADAR_MODELL_LEKTORAT=
RADAR_MODELL_SEO=
RADAR_MODELL_DOSSIER=

# ===== Freigabe-App =====
WEB_USER=redaktion
WEB_PASSWORD=                    # Pflicht, mindestens 12 Zeichen – ohne startet das Cockpit nicht (Notzugang, Rolle admin)
WEB_SECRET=                      # python -c "import secrets; print(secrets.token_urlsafe(32))"
RADAR_WEB_URL=https://radar.example.de   # öffentliche Adresse (Cloudflare Tunnel), für Links in Benachrichtigungen
RADAR_PROXY_HOPS=0               # hinter einem Reverse-Proxy (Coolify/Traefik): 1
RADAR_LESE_TOKEN=                # optional: GET /api/bericht mit Authorization: Bearer <Token> (nur lesen)
RADAR_AGENT_TOKEN=               # optional: Agent-Modus übers Netz – GET /api/agent/export, POST /api/agent/import

# ===== Nachrichten-APIs (optional, RSS/Google News laufen ohne Token) =====
NEWSAPI_KEY=
GNEWS_TOKEN=

# ===== Bilder: KI-Symbolbild → Bildpool → Stockfoto → Tamil.de-Bildkarte (nie ohne Bild) =====
GEMINI_API_KEY=                  # Google AI Studio; Bildmodell „Nano Banana“ (ca. 0,03–0,05 $ je Bild)
BILD_MODELL=gemini-nano-banana-2.1   # Alternativen: gemini-3.1-flash-image, gemini-3-pro-image
BILD_GROESSE=1K                  # 1K | 2K | 4K
BILD_MODUS=ki                    # v1: ki | pool | stock | karte – wo die Bildkette beginnt (v2: BILD_REIHENFOLGE)
BILD_POOL_DIR=                   # Standard: data/bildpool  (python -m news_radar bildpool fuellen)
UNSPLASH_ACCESS_KEY=             # optional: freie Stockfotos vor der Bildkarte
PEXELS_API_KEY=

# ===== WordPress (leer = Entwürfe warten in der App, „Direkt posten“ ist ausgeblendet) =====
WP_URL=https://www.tamil.de
WP_USER=ki-agent                 # Rolle: Autor
WP_APP_PASSWORD=                 # WordPress > Benutzer > Profil > Anwendungspasswörter
WP_POST_STATUS=publish           # publish = „Direkt posten“ geht live; pending/draft = nochmal Review in WordPress
WP_SEO_META=none                 # rankmath | yoast | none

# ===== Benachrichtigung (Slack/Teams/Discord-Webhook) =====
NOTIFY_WEBHOOK_URL=

# ===== Steuerung =====
RADAR_MAX_ARTICLES=5             # max. neue Entwürfe je Lauf
RADAR_MAX_DRAFTS_PER_DAY=40      # Kostendeckel (ca. 0,05 € je Entwurf)
RADAR_MAX_AGE_HOURS=36           # nur Meldungen jünger als X Stunden (Erstbefüllung: run --max-age-hours 336)
RADAR_MIN_SCORE=4                # Stichwort-Schwelle ohne DACH-Bezug
RADAR_MIN_SCORE_DACH=2           # Stichwort-Schwelle mit DACH-Bezug
RADAR_MIN_RELEVANCE=6            # Mindest-Relevanz laut KI (1-10)
RADAR_FETCH_SECONDS=60           # Zeitbudget fürs Einsammeln
RADAR_DEADLINE_SECONDS=270       # Lauf endet spätestens nach 4,5 Minuten
